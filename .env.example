# =============================================================================
# SupplySight AI — Environment Variable Template
# Purpose: Document required configuration without committing real secrets.
# Usage: Copy to `.env` and fill in local/dev/staging/production values.
# =============================================================================

# ----- Application -----
APP_NAME=SupplySight AI
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ----- Backend (FastAPI) -----
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8000

# ----- Database (PostgreSQL) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplysight_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Prefer POSTGRES_* over DATABASE_URL when the password contains @ or other reserved chars
# DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5432/supplysight_ai

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# DB_ECHO=false

# ----- Authentication (prepared; not enforced until AUTH_ENABLED=true) -----
AUTH_ENABLED=false
# JWT_SECRET_KEY=replace_with_long_random_string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----- AI Copilot (Groq + LangChain) -----
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here
# If GROQ_API_KEY is missing, the API falls back to the rules engine.
