# =============================================================================
# SupplySight AI — Environment Variable Template
# Purpose: Document required configuration without committing real secrets.
# Usage: Copy to `.env` and fill in local/dev/staging/production values.
# =============================================================================

# ----- Application -----
APP_NAME=SupplySight AI
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ----- Backend (FastAPI) -----
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
# CORS_ORIGINS=http://localhost:3000

# ----- Database (PostgreSQL) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplysight_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ritzvit@2004
DATABASE_URL=postgresql+psycopg2://postgres:ritzvit@2004@localhost:5432/supplysight_ai

# ----- Authentication (placeholders for future implementation) -----
# JWT_SECRET_KEY=replace_with_long_random_string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----- ML / Paths (placeholders) -----
# ML_ARTIFACTS_DIR=./ml/artifacts
# ML_MODELS_DIR=./ml/models
